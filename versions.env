# Single source of truth for every version constraint used by the installer.
# Sourced by scripts/setup.sh (and therefore by every module).

# Minimum Neovim required by LazyVim. Verified against the LazyVim README
# (https://github.com/LazyVim/LazyVim#%EF%B8%8F-requirements): "Neovim >= 0.11.2".
NVIM_MIN_VERSION="0.11.2"

# Version installed *only* when no usable nvim exists on the machine.
# Latest stable Neovim release at the time of writing.
NVIM_INSTALL_VERSION="v0.12.5"

# Highest Neovim feature release this config has been tested against.
# Anything newer produces a warning, never an error.
NVIM_MAX_TESTED="0.12"

# Node is never installed by this repo (the user manages it with a version
# manager); it is only checked, and a missing/old Node downgrades tooling.
NODE_MIN_MAJOR=20

# Nerd Font family and the nerd-fonts release it is pulled from.
NERD_FONT="JetBrainsMono"
NERD_FONT_VERSION="v3.5.1"
